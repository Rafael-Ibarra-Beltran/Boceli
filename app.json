{
  "expo": {
    "name": "Boceli",
    "slug": "boceli",
    "scheme": "boceli",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.boceli.personal",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.boceli.personal",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF8F0"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Selecciona una foto de tu plato para revisarla en Boceli.",
          "cameraPermission": "Fotografía tu plato para estimar y revisar tu comida.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo_short.png",
          "imageWidth": 140,
          "backgroundColor": "#FFF8F0"
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
