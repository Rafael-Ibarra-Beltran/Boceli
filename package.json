{
  "name": "boceli",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "EXPO_NO_TELEMETRY=1 expo start",
    "ios": "EXPO_NO_TELEMETRY=1 expo start --ios",
    "android": "EXPO_NO_TELEMETRY=1 expo start --android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src",
    "check": "bun run typecheck && bun run lint",
    "export:native": "EXPO_NO_TELEMETRY=1 expo export --platform ios --platform android"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "expo": "~58.0.17",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  }
}
